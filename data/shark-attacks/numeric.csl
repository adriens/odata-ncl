<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/ontology/bibsonomy/style" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="fr-FR">
  <info>
    <title>Numeric repeated</title>
    <id>http://www.zotero.org/styles/numeric-repeated</id>
    <link href="http://www.zotero.org/styles/numeric-repeated" rel="self"/>
    <author>
      <name>Adrien Sales</name>
    </author>
    <category citation-format="numeric"/>
    <updated>2026-02-28T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="author" suffix=", "/>
      <text variable="title" font-style="italic" suffix=", "/>
      <date variable="issued" prefix="(" suffix=")">
        <date-part name="year"/>
      </date>
      <text variable="URL" prefix=" [En ligne]: "/>
    </layout>
  </bibliography>
</style>
